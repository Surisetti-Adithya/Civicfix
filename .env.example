# =============================================================================
# CivicFix Environment Configuration Template
# =============================================================================

PROJECT_NAME="CivicFix"
ENVIRONMENT="development"

# --- Database Configuration ---
# Local SQLite for testing:
DATABASE_URL="sqlite:///./civicfix.db"
# Docker Compose PostgreSQL:
# DATABASE_URL="postgresql://civicfix:civicfix_secret@db:5432/civicfix"

POSTGRES_USER="civicfix"
POSTGRES_PASSWORD="civicfix_secret"
POSTGRES_DB="civicfix"

SECRET_KEY="replace_with_secure_random_secret_in_production"
SESSION_EXPIRE_HOURS=24
UPLOAD_DIR="/home/alumina/civic/uploads"
MAX_UPLOAD_SIZE_BYTES=10485760
AUTO_SEED=true

# =============================================================================
# AI Configuration: Google Gemini & Gemma
# =============================================================================
# Supported AI_PROVIDER values: "gemini", "ollama", "fake", "disabled"

# --- Option A: Hosted Google Gemini / Gemma API ---
AI_PROVIDER="gemini"
AI_MODEL_NAME="gemini-2.5-flash"
GEMINI_API_KEY=""

# --- Option B: Local Gemma Container via Ollama in Docker ---
# To use local Gemma in Docker Compose:
# 1. Set AI_PROVIDER="ollama"
# 2. Inside Docker, OLLAMA_BASE_URL="http://ollama:11434" (or "http://localhost:11434" if running locally)
# 3. Choose Gemma model: "gemma2:2b", "gemma2:9b", or "gemma:2b"
# AI_PROVIDER="ollama"
# AI_MODEL_NAME="gemma2:2b"
# GEMMA_MODEL="gemma2:2b"
# OLLAMA_BASE_URL="http://localhost:11434"

# --- AI Guardrail & Performance Settings ---
AI_TIMEOUT_SECONDS=15.0
AI_MAX_RETRIES=1
AI_DESCRIPTION_MAX_CHARS=1500
AI_RATE_LIMIT_PER_MINUTE=20

# --- Demo Mode Settings ---
ENABLE_DEMO_IDENTITY=true
